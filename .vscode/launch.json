{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Workshop: Run API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/AgenticWorkflows.Api/bin/Debug/net10.0/AgenticWorkflows.Api.dll",
      "cwd": "${workspaceFolder}/src/AgenticWorkflows.Api",
      "preLaunchTask": "Workshop: Build solution",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5154"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
