{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workshop: Restore solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "AgenticWorkflows.slnx"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Workshop: Build solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "AgenticWorkflows.slnx",
        "--no-restore"
      ],
      "dependsOn": "Workshop: Restore solution",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Workshop: Test solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "AgenticWorkflows.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Workshop: Run API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/AgenticWorkflows.Api/AgenticWorkflows.Api.csproj",
        "--urls",
        "http://0.0.0.0:5154"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Now listening on:"
        }
      }
    }
  ]
}
