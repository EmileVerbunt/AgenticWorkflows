{
  "name": "Agentic Workflows Workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [
    5154
  ],
  "portsAttributes": {
    "5154": {
      "label": "Agentic Workflows API",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "sed -i 's/\\r$//' .devcontainer/*.sh && bash .devcontainer/postCreate.sh",
  "postStartCommand": "sed -i 's/\\r$//' .devcontainer/*.sh && bash .devcontainer/postStart.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "ms-dotnettools.csdevkit"
      ],
      "settings": {
        "task.allowAutomaticTasks": "on",
        "terminal.integrated.defaultLocation": "editor"
      }
    }
  },
  "remoteEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "GH_AW_VERSION": "v0.83.1"
  }
}
